# Workflow:stage_outline
# Function:stage_outlinesaved,extractchapter_outlinebatchCreatechapter_outlinechapter_body
# Trigger:stage_outlinecardsavedauto trigger

#@node(description="Trigger:Watchstage_outlinecardsaved")
trigger = Trigger.CardSaved(card_type="stage_outline")
#</node>


#@node(description="Readstage_outline")
stage = Card.Read(card_id=trigger.card_id)
#</node>


#@node(description="extractchapter_outline")
enriched_outlines = Logic.Expression(
    expression="[{**outline, 'title': (str(outline.get('title') or '') if str(outline.get('title') or '').startswith('No.' + str(outline.get('chapter_number')) + ' chapter ') else ('No.' + str(outline.get('chapter_number')) + ' chapter ' + str(outline.get('title') or ''))), 'entity_list': (outline.get('entity_list') or []), 'volume_number': stage.content.volume_number, 'stage_number': stage.content.stage_number} for outline in stage.content.chapter_outline_list or []]"
  )
#</node>


#@node(description="chapter")
validated_outlines = Logic.Expression(
    expression="enriched_outlines.result if (stage.content.reference_chapter and len(stage.content.reference_chapter) == 2 and [int(item.get('chapter_number', -1)) for item in enriched_outlines.result] == list(range(int(stage.content.reference_chapter[0]), int(stage.content.reference_chapter[1]) + 1))) else []"
  )
#</node>


#@node(async=true, description="batchCreatechapter_outline(async)")
outline_cards = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="chapter_outline",
    title_template="{item.title}",
    items=validated_outlines.result
  )
#</node>


#@node(async=true, description="batchCreatechapter_body(async)")
content_cards = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="chapter_body",
    title_template="{item.title}",
    content_template={
      "volume_number": "{item.volume_number}",
      "stage_number": "{item.stage_number}",
      "chapter_number": "{item.chapter_number}",
      "title": "{item.title}",
      "entity_list": "{item.entity_list}"
    },
    items=validated_outlines.result
  )
#</node>


#@node(description="waitasynccomplete")
wait_result = Logic.Wait(tasks=[outline_cards, content_cards])
#</node>


#@node(description="")
update_result = Card.Update(
    card_id=trigger.card_id,
    content_merge={
      "chapter_outline_list": []
    }
  )
#</node>
